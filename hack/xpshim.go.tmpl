// Package xpshim re-exports the MongoDB Atlas Terraform provider constructors
// that live in internal/provider so that the Crossplane provider can run them
// in-process (upjet no-fork architecture).
//
// This file is injected into the extracted provider module by the
// `make provider-source` target. It lives inside the module root, which makes
// the internal/ import legal per Go's internal-package rule.
package xpshim

import (
	"errors"
	"net/http"

	tpf "github.com/hashicorp/terraform-plugin-framework/provider"
	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/schema"

	"github.com/mongodb/terraform-provider-mongodbatlas/internal/config"
	"github.com/mongodb/terraform-provider-mongodbatlas/internal/provider"
)

// GetSDKProvider returns the SDKv2 half of the muxed Atlas provider.
func GetSDKProvider() *schema.Provider {
	return provider.NewSdkV2Provider()
}

// GetFrameworkProvider returns the plugin-framework half of the muxed Atlas
// provider.
func GetFrameworkProvider() tpf.Provider {
	return provider.NewFrameworkProvider()
}

// NewOfflineClient builds the Atlas client that the provider's resources expect
// as their meta (SDKv2) or provider data (framework), authenticating with the
// given programmatic API key, and sends every request of every Atlas SDK the
// client carries through rt instead of the network. It is the hook of the
// Crossplane provider's offline diff server, whose rt refuses every request.
//
// The client is built the way the configured provider builds it, so that it
// carries every SDK client the resources read off it, and the transport is
// swapped afterwards: config.NewClient builds one *http.Client and hands it to
// each SDK, so replacing that client's transport guards them all. An API key
// or an access token builds without a network round trip; a service account
// mints its token on construction. The four admin SDK clients are checked to
// share the HTTP client, as a change upstream that gave one of them a client
// of its own would otherwise leave that one unguarded. The legacy Atlas
// client hides its HTTP client, so only TestOfflineClientBlocksEgress guards
// it. The Realm client does not use the shared HTTP client and authenticates
// lazily, so it is replaced with one without keys, which refuses before it
// sends anything.
func NewOfflineClient(publicKey, privateKey, terraformVersion string, rt http.RoundTripper) (any, error) {
	c, err := config.NewClient(&config.Credentials{PublicKey: publicKey, PrivateKey: privateKey}, terraformVersion)
	if err != nil {
		return nil, err
	}
	hc := c.AtlasV2.GetConfig().HTTPClient
	for _, other := range []*http.Client{
		c.AtlasPreview.GetConfig().HTTPClient,
		c.AtlasV220240530.GetConfig().HTTPClient,
		c.AtlasV220241113.GetConfig().HTTPClient,
	} {
		if other != hc {
			return nil, errors.New("the Atlas admin SDK clients do not share one HTTP client, so one transport cannot guard them all")
		}
	}
	hc.Transport = rt
	c.Realm = &config.RealmClient{}
	return c, nil
}
