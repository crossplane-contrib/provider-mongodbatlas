// This file is injected into the extracted provider module's internal/config package by `make provider-source`,
// where it can reach the package's unexported service account token cache; xpshim re-exports its function.

package config

// ForgetStaleServiceAccount drops the token source cached for clientID when it was built with another secret,
// so that the next Configure builds one with clientSecret.
//
// The upstream cache is keyed by client ID only: once the secret differs,
// every Configure fails with "service account credentials changed".
// A Terraform run is too short to notice, but a long-running controller hits it on every secret rotation.
// Clients built earlier keep the token source they hold.
func ForgetStaleServiceAccount(clientID, clientSecret string) {
	saTokenSourceCache.mu.Lock()
	defer saTokenSourceCache.mu.Unlock()
	if e, ok := saTokenSourceCache.sources[clientID]; ok && e.clientSecret != clientSecret {
		delete(saTokenSourceCache.sources, clientID)
	}
}
